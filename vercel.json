{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/rss",        "destination": "/api/rss" },
    { "source": "/api/(.*)",   "destination": "/api/$1" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ]
}
